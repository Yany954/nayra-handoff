# Copy to .env.local for local development against the Firebase emulators.
# `npm run emulators` starts them; `npm run seed` fills them with the site content.
GCLOUD_PROJECT=demo-nayra
FIRESTORE_EMULATOR_HOST=127.0.0.1:8080
FIREBASE_AUTH_EMULATOR_HOST=127.0.0.1:9099
FIREBASE_STORAGE_EMULATOR_HOST=127.0.0.1:9199
FIREBASE_STORAGE_BUCKET=demo-nayra.appspot.com
# Skips the Google Cloud metadata lookup that only exists on GCP.
METADATA_SERVER_DETECTION=none

# Google accounts allowed into /panel (phase 4), comma-separated. Real values only in .env.local / secrets.
ADMIN_EMAILS=

# Browser Firebase config (public by design). In dev the demo values talk to the Auth emulator.
NEXT_PUBLIC_FIREBASE_API_KEY=demo-key
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=demo-nayra.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=demo-nayra
NEXT_PUBLIC_FIREBASE_AUTH_EMULATOR_HOST=127.0.0.1:9099
