{
  "name": "nayra-lancheros",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "vitest run --passWithNoTests",
    "test:watch": "vitest",
    "emulators": "firebase emulators:start --import ./emulator-data --export-on-exit",
    "seed": "tsx --env-file-if-exists=.env.local scripts/seed-emulator.ts",
    "test:rules": "vitest run -c vitest.rules.config.mts",
    "test:rules:ci": "firebase emulators:exec --only firestore,storage \"npm run test:rules\""
  },
  "dependencies": {
    "firebase-admin": "^14.5.1",
    "next": "16.4.6",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "^5.0.2",
    "@tailwindcss/turbopack": "4.3.3",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.4.6",
    "firebase": "^13.4.0",
    "firebase-tools": "^15.37.0",
    "tailwindcss": "4.3.3",
    "tsx": "^4.23.15",
    "typescript": "^5",
    "vite": "^8.3.8",
    "vitest": "^5.1.1"
  }
}
