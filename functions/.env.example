# Comma-separated Google accounts allowed into /panel. Copy to .env.local for the emulator.
ADMIN_EMAILS=

# In functions/.env.<project-id>: set to false until the scan secrets exist (docs/scan-setup.md).
# SCAN_ENABLED=false
# Cheap model for event extraction (see docs/scan-setup.md)
OPENAI_MODEL=gpt-5-mini
# Set to false until GMAIL_APP_PASSWORD exists (contact form email).
# MAIL_ENABLED=false
